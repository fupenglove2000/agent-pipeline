# Copy to .env and fill in real values. .env is gitignored.

DATABASE_URL=postgresql+psycopg://agent_pipeline:agent_pipeline@localhost:5432/agent_pipeline
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# USD ceilings; per-run must be >= per-task.
PER_TASK_COST_CEILING_USD=0.50
PER_RUN_COST_CEILING_USD=50.00

TASK_LEASE_TIMEOUT_SECONDS=900
